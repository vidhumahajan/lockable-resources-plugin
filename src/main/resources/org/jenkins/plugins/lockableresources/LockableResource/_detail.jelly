<?jelly escape-by-default='true'?>
<!--
  Body of the resource detail page. Included by index.jelly.

  'it' is the LockableResource, 'action' the LockableResourcesRootAction and
  'baseUrl' the URL of the root action (ending with '/').
 -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler" xmlns:i="jelly:fmt">
  <link rel="stylesheet" href="${resURL}/plugin/lockable-resources/css/style.css"/>

  <!-- data-resource-* and the property pills below are read by the shared edit dialog -->
  <div class="lr-resource-detail"
       data-lr-base-url="${baseUrl}"
       data-resource-name="${it.name}"
       data-resource-description="${it.description != null ? it.description : ''}"
       data-resource-labels="${it.labels != null ? it.labels : ''}"
       data-resource-group="${it.group}">

    <a class="lr-resource-detail__back" href="${baseUrl}">
      <l:icon src="symbol-arrow-back-outline plugin-ionicons-api" />
      <span>${%back}</span>
    </a>

    <l:app-bar title="${it.name}">
      <div class="lr-resource-detail__actions">
        <j:set var="resource" value="${it}"/>
        <j:set var="lrShowLabels" value="${true}"/>
        <j:set var="lrDetailPage" value="${true}"/>
        <st:include page="_resourceActions.jelly" it="${action}"/>
      </div>
    </l:app-bar>
    <st:include page="_resourceDialogs.jelly" it="${action}"/>

    <!-- ****************************************************************** Status -->
    <j:set var="heldSince" value="${action.getHeldSince(it)}"/>
    <div class="lr-resource-detail__grid">
    <section class="lr-resource-detail__card">
      <h2 class="jenkins-section__title">${%section.status}</h2>
      <dl class="lr-resource-detail__list">
        <dt>${%field.status}</dt>
        <dd>
          <j:choose>
            <j:when test="${it.reservedBy != null}">
              <strong class="lr-resource-detail__status jenkins-!-destructive-color">${%status.reserved}</strong>
            </j:when>
            <j:when test="${it.remoteLockedBy != null}">
              <strong class="lr-resource-detail__status jenkins-!-warning-color">${%status.locked}</strong>
            </j:when>
            <j:when test="${it.locked}">
              <strong class="lr-resource-detail__status jenkins-!-warning-color">${%status.locked}</strong>
              <st:include page="_releaseDelay.jelly"/>
            </j:when>
            <j:when test="${it.queued}">
              <strong class="lr-resource-detail__status jenkins-!-warning-color">${%status.queued}</strong>
            </j:when>
            <j:when test="${it.disabled}">
              <strong class="lr-resource-detail__status jenkins-!-destructive-color">${%status.disabled}</strong>
            </j:when>
            <j:otherwise>
              <strong class="lr-resource-detail__status jenkins-!-success-color">${%status.free}</strong>
            </j:otherwise>
          </j:choose>
          <j:if test="${it.ephemeral}">
            <span class="lr-static-label">${%ephemeral}</span>
          </j:if>
        </dd>

        <j:if test="${it.disabled}">
          <dt>${%field.disabled}</dt>
          <dd>${it.disabledCause}</dd>
        </j:if>

        <j:if test="${!it.free}">
          <dt>${%field.heldBy}</dt>
          <dd>
            <j:choose>
              <j:when test="${it.reservedBy != null}">
                <a href="${rootURL}/user/${action.encodePathSegment(it.reservedBy)}">${it.reservedBy}</a>
              </j:when>
              <j:when test="${it.remoteLockedBy != null}">
                <j:set var="remoteLockRecord" value="${it.remoteLockRecord}"/>
                <j:choose>
                  <j:when test="${remoteLockRecord != null and remoteLockRecord.clientId != null}">
                    ${%heldBy.remote(remoteLockRecord.clientId)}
                  </j:when>
                  <j:otherwise>${%heldBy.remoteUnknown}</j:otherwise>
                </j:choose>
              </j:when>
              <!-- Release delay of a build that has been deleted meanwhile, as in the resources table -->
              <j:when test="${it.locked and it.build == null and it.releaseDelayed}">
                ${it.buildExternalizableId}
              </j:when>
              <j:when test="${it.locked}">
                <a href="${rootURL}/${it.build.url}">${it.build.fullDisplayName}</a>
                <st:include page="_shareHolders.jelly"/>
              </j:when>
              <j:when test="${it.queued}">
                ${it.queueItemProject}
              </j:when>
            </j:choose>
          </dd>
        </j:if>

        <j:if test="${heldSince != null}">
          <dt>${%field.since}</dt>
          <dd>
            <i:formatDate value="${heldSince}" type="both" dateStyle="medium" timeStyle="short"/>
            <span class="jenkins-!-color-secondary jenkins-!-margin-left-1">(${%ago(h.getTimeSpanString(heldSince))})</span>
          </dd>
        </j:if>

        <j:if test="${it.lockReason != null and !it.lockReason.isEmpty()}">
          <dt>${%field.reason}</dt>
          <dd>${it.lockReason}</dd>
        </j:if>
      </dl>
    </section>

    <!-- ****************************************************************** Details -->
    <section class="lr-resource-detail__card">
      <h2 class="jenkins-section__title">${%section.details}</h2>
      <dl class="lr-resource-detail__list">
        <dt>${%field.group}</dt>
        <dd>${it.group}</dd>

        <dt>${%field.description}</dt>
        <dd>
          <j:choose>
            <j:when test="${it.description != null and !it.description.isEmpty()}">${it.description}</j:when>
            <j:otherwise><span class="jenkins-!-color-secondary">${%none}</span></j:otherwise>
          </j:choose>
        </dd>

        <dt>${%field.labels}</dt>
        <dd>
          <j:choose>
            <j:when test="${it.labelsAsList.size() gt 0}">
              <j:forEach var="label" items="${it.labelsAsList}">
                <a class="lr-resource-detail__label" href="${rootURL}/label/${action.encodePathSegment(label)}">${label}</a>
              </j:forEach>
            </j:when>
            <j:otherwise><span class="jenkins-!-color-secondary">${%none}</span></j:otherwise>
          </j:choose>
        </dd>

        <dt>${%field.properties}</dt>
        <dd>
          <j:choose>
            <j:when test="${it.properties.size() gt 0}">
              <div class="lr-properties-pills">
                <j:forEach var="property" items="${it.properties}">
                  <span class="lr-property-pill">
                    <span class="lr-property-pill__key">${property.name}</span>
                    <span class="lr-property-pill__value">${property.value}</span>
                  </span>
                </j:forEach>
              </div>
            </j:when>
            <j:otherwise><span class="jenkins-!-color-secondary">${%none}</span></j:otherwise>
          </j:choose>
        </dd>

        <dt>${%field.note}</dt>
        <dd>
          <j:choose>
            <j:when test="${it.note != null and !it.note.isEmpty()}">
              <div class="lr-note-wrapper">
                <j:out value="${app.markupFormatter.translate(it.note)}"/>
              </div>
            </j:when>
            <j:otherwise><span class="jenkins-!-color-secondary">${%none}</span></j:otherwise>
          </j:choose>
        </dd>
      </dl>
    </section>
    </div>

    <!-- ****************************************************************** Queue -->
    <!-- Same server-side paged table as the Queue tab of the main page, limited to this resource -->
    <section class="lr-resource-detail__card lr-resource-detail__card--queue">
      <h2 class="jenkins-section__title">${%section.queue} <span class="lr-table-count" id="lr-queue-total">…</span></h2>
      <div class="lr-tab-pane lr-tab-pane--active" id="lr-tab-queue">
        <div class="lr-toolbar">
          <div class="lr-toolbar__filters">
            <input type="text" class="jenkins-input lr-queue-filter" id="lr-queue-filter-type" placeholder="${%filter.queue.type}" />
            <input type="text" class="jenkins-input lr-queue-filter" id="lr-queue-filter-request" placeholder="${%filter.queue.request}" />
            <input type="text" class="jenkins-input lr-queue-filter" id="lr-queue-filter-requested-by" placeholder="${%filter.queue.requestedBy}" />
          </div>
          <div class="lr-toolbar__actions">
            <button class="jenkins-button jenkins-button--tertiary lr-reset-filters-btn" tooltip="${%filter.reset.tooltip}">
              <l:icon src="symbol-close-circle-outline plugin-ionicons-api" />
            </button>
            <div class="lr-col-visibility-wrapper">
              <button id="lr-queue-col-visibility-toggle" class="jenkins-button jenkins-button--tertiary" tooltip="${%filter.columns.tooltip}">
                <l:icon src="symbol-eye-outline plugin-ionicons-api" />
              </button>
              <div id="lr-queue-col-visibility-menu" class="lr-col-visibility-menu" style="display:none;"></div>
            </div>
          </div>
        </div>
        <j:set var="queueResource" value="${it.name}"/>
        <j:set var="queueEmptyText" value="${%queue.empty}"/>
        <st:include page="tableQueue/table" it="${action}"/>
      </div>
      <p class="jenkins-!-color-secondary lr-resource-detail__hint">${%queue.scriptHint}</p>
    </section>
  </div>

  <script type="text/javascript" src="${resURL}/plugin/lockable-resources/js/lockable-resources.js"/>
</j:jelly>
